// Move quenched to cradle
{
    <Vessel View>
    <Cradle View>
    <Quenched Concept>
}
Flock's Disintegration
Numerical Reflection: 64
Transfer Substance
Bookkeeper's Gambit: v

// Make phial
Contemplation
<Cradle Pos>
Entity Purification: Item
Craft Phial

// Waste media
Mind's Reflection
Media Reflection
Numerical Reflection: 128
Subtractive Distillation
Numerical Reflection: 2
Division Distillation
Anchorite's Flight

// Get recipe
Contemplation
<Assembler Pos>
List Items
{
    Sekhmet' Gambit: 1
    Sorter's Purification
    Contemplation
    <Phial>
    Equality Distillation
}
Refinement Distillation

// Move phials to vessel
{
    <Pocket View>
    <Vessel View>
}
Flock's Disintegration
Prospector's Gambit
Inquiry Purification
{
    Sekhmet' Gambit: 3
    Gemini Decomposition
    Dwelling Purification
    Contemplation
    <"item">
    Selection Distillation
    Contemplation
    <"hexcasting:battery">
    Equality Distillation
    {
        Numerical Reflection: 1
        Transfer Substance
        Bookkeeper's Gambit: v
    }
    Contemplation
    Sekhmet's Gambit: 0
    Augur's Exaltation
    Hermes' Gambit
}
Jester's Gambit
Thoth's Gambit
Bookkeeper's Gambit: vvv

// Grab 1 dust from vessel, then use it to set the recipe
{
    <Vessel View>
    <Pocket View>
    <Dust Concept>
}
Flock's Disintegration
Numerical Reflection: 1
Transfer Substance
Bookkeeper's Gambit: v
Set Recipe

// A single slate here needs BK: v to delete the bool the assembler leaves.

{ // After craft, ran by Hermes after the crafter
    // Move bottle to pocket sim. BOTTLE MUST BE FIRST - ALWAYS IN SLOT 0
    {
        <Vessel View>
        <Pocket View>
        <Bottle Concept>
    }
    Flock's Disintegration
    Numerical Reflection: 1
    Transfer Substance

    // Move phial to pocket sim
    {
        <Vessel View>
        <Pocket View>
    }
    Flock's Disintegration
    Prospector's Gambit
    Inquiry Purification
    {
        Gemini Decomposition
        Dwelling Purification
        Contemplation
        <"item">
        Selection Distillation
        Contemplation
        <"hexcasting:battery">
        Equality Distillation
        {
            Numerical Reflection: 1
            Transfer Substance
            Bookkeeper's Gambit: v
        }
        Contemplation
        Sekhmet's Gambit: 0
        Augur's Exaltation
        Hermes' Gambit
    }
    Jester's Gambit
    Thoth's Gambit
    Sekhmet's Gambit: 0
}
